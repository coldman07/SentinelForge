FROM rust:1.89-bookworm AS detection-build
WORKDIR /src
COPY detection/Cargo.toml detection/Cargo.lock ./detection/
COPY detection/src ./detection/src
RUN cargo build --release --manifest-path detection/Cargo.toml

FROM golang:1.24-alpine AS gateway-build
WORKDIR /src/gateway
COPY gateway/go.mod gateway/go.sum ./
RUN go mod download
COPY gateway/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/gateway . \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/event-store ./cmd/event-store

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=gateway-build /out/gateway /usr/local/bin/gateway
COPY --from=gateway-build /out/event-store /usr/local/bin/event-store
COPY --from=detection-build /src/detection/target/release/sentinelforge-detection /usr/local/bin/sentinelforge-detection
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/gateway"]
